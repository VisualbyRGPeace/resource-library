# Sao chép file này thành .dev.vars để chạy local (npm run dev).
# KHÔNG commit .dev.vars. Trên production, đặt bằng: npx wrangler secret put <TÊN>

# --- BẮT BUỘC ---
ADMIN_EMAIL=you@example.com
# Tạo bằng: npm run hash-password
ADMIN_PASSWORD_HASH=
# Chuỗi ngẫu nhiên dài (npm run hash-password cũng in sẵn một chuỗi)
SESSION_SECRET=

# --- TÙY CHỌN: tải file lớn trực tiếp từ R2 (không qua Worker) ---
# R2_ACCOUNT_ID đặt trong wrangler.jsonc (không phải bí mật).
# Tạo R2 API token quyền "Object Read only", giới hạn đúng bucket này.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
